# Documentation template only. Spring Boot and Vite do not automatically load this file.
# Copy these values into backend/backend/application-local.properties or your process environment.
MYSQL_URL=jdbc:mysql://localhost:3306/fixflow
MYSQL_USER=replace-with-local-mysql-account
MYSQL_PASSWORD=replace-with-local-mysql-password

# Generate a unique random value with at least 32 bytes of entropy.
JWT_SECRET=replace-with-random-secret-at-least-32-bytes
JWT_EXPIRATION_MS=28800000

FIXFLOW_ADMIN_USERNAME=replace-with-initial-admin-username
FIXFLOW_ADMIN_PASSWORD=replace-with-strong-initial-admin-password
FIXFLOW_ADMIN_FULL_NAME=Administrator

CORS_ALLOWED_ORIGINS=http://localhost:5173
FIXFLOW_SLA_APPROACHING_DAYS=2
VITE_API_BASE_URL=http://localhost:8080
